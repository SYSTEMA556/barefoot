<h1>ログイン</h1>

<%= form_with url: sessions_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :email, 'メールアドレス' %><br>
    <%= f.email_field :email, required: true %>
  </div>

  <div class="field">
    <%= f.label :password, 'パスワード' %><br>
    <%= f.password_field :password, required: true %>
  </div>

  <div class="actions">
    <%= f.submit 'ログイン' %>
  </div>
<% end %>

<p>
  <%= link_to "パスワードを忘れた…", new_password_reset_path %>
</p>
<p>
  <%= link_to "新規登録はこちら", new_user_path %>
</p>
