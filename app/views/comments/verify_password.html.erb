<!-- app/views/comments/verify_password.html.erb -->
<h3>コメント削除の確認</h3>

<%= form_with url: confirm_delete_comment_path(@comment), method: :post do |f| %>
  <div class="mb-3">
    <%= label_tag :password, "コメント投稿時に設定したパスワード" %>
    <%= password_field_tag :password, nil, class: "form-control" %>
  </div>
  <%= submit_tag "削除する", class: "btn btn-danger" %>
<% end %>
