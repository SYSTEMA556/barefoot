<!-- app/views/comments/verify_password.html.erb -->
<h2>コメント削除のためのパスワードを入力してください</h2>

<%= form_with model: @comment,
              url: confirm_delete_novel_comment_path(@novel, @comment),
              method: :post,
              local: true do |f| %>
  <div class="mb-3">
    <%= f.label :guest_password, "ゲスト用パスワード" %>
    <%= f.password_field :guest_password, class: "form-control" %>
  </div>
  <%= f.submit "削除する", class: "btn btn-danger" %>
<% end %>

<% if flash.now[:alert].present? %>
  <div class="alert alert-danger mt-3"><%= flash.now[:alert] %></div>
<% end %>
