<!-- app/views/comments/_comment.html.erb -->
<div class="position-relative mb-3 p-3 border rounded">
  <p><%= comment.body %></p>
  <% if comment.persisted? %>
    <div class="position-absolute top-0 end-0">
      <!-- ゲストパスワード入力画面へ飛ぶリンク -->
      <%= link_to '🗑', verify_password_novel_comment_path(comment.novel, comment),
                  class: 'btn btn-sm btn-outline-danger',
                  title: "削除にはパスワードが必要です" %>
    </div>
  <% end %>
</div>
