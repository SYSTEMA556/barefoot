<!-- app/views/comments/_comment.html.erb -->
<div class="comment mb-3 p-3 border rounded position-relative bg-light">
  <p><strong><%= comment.user&.user_name || "名無し" %>：</strong></p>
  <p><%= simple_format(comment.body) %></p>

  <div class="position-absolute top-0 end-0">
    <%= link_to '🗑', verify_password_comment_path(comment),
                class: 'btn btn-sm btn-outline-danger',
                title: "削除にはパスワードが必要です" %>
  </div>
</div>
