<!-- app/views/users/show.html.erb -->
<section class="mb-5">
  <h2 class="h4"><%= @user.user_name %> さんのページ</h2>
 <!-- <p>Email: <%= @user.email %></p>  危ないが過ぎる-->

  <h3 class="h5 mt-4">投稿作品一覧</h3>
  <div class="row row-cols-1 row-cols-lg-2 g-4">
  <% @novels.each do |novel| %>
    <%= render partial: "novels/novel_card", locals: { novel: novel } %>
  <% end %>
</div>

  <% if defined?(paginate) %>
    <nav aria-label="Page navigation" class="mt-4">
      <ul class="pagination justify-content-center">
        <%= paginate @novels, theme: 'bootstrap-5' %>
      </ul>
    </nav>
  <% end %>
</section>
