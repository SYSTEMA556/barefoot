<nav class="navbar navbar-expand-lg bg-body-tertiary"
     data-bs-theme="<%= cookies[:bs_theme] || 'body' %>"
     id="mainNavbar">
  <div class="container-fluid">
    <%= link_to '東方夜伽話', novels_path, class: 'navbar-brand' %>

    <!-- ハンバーガー -->
    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center gap-2 px-2">
        <!-- 新規投稿 -->
        <li class="nav-item">
          <%= link_to new_novel_path, class: 'nav-link py-2 px-3' do %>
            <i class="bi bi-journal-plus me-1"></i> 新規投稿
          <% end %>
        </li>

        <!-- ドロップダウンリスト -->
<li class="nav-item dropdown">
  <a class="nav-link dropdown-toggle" href="#" role="button"
     data-bs-toggle="dropdown" aria-expanded="false">
    <% if user_signed_in? %>
      <%= current_user.user_name %>
    <% else %>
      アカウント
    <% end %>
  </a>
  <ul class="dropdown-menu">
    <% if user_signed_in? %>
      <li><%= link_to "プロフィール", edit_user_registration_path, class: "dropdown-item" %></li>
      <li><%= link_to "ブックマーク",   bookmarks_path,          class: "dropdown-item" %></li>
      <li><hr class="dropdown-divider"></li>
      <!-- ここを pages_logout_path ではなく logout_confirm_path に -->
      <li><%= link_to "ログアウト確認", logout_confirm_path, class: "dropdown-item" %></li>
    <% else %>
      <li><%= link_to "ログイン",       new_user_session_path,      class: "dropdown-item" %></li>
      <li><%= link_to "新規登録",       new_user_registration_path, class: "dropdown-item" %></li>
      <li><hr class="dropdown-divider"></li>
      <li><%= link_to "パスワードをお忘れの方", new_user_password_path, class: "dropdown-item" %></li>
    <% end %>
  </ul>
</li>

        <!-- 検索バー -->
        <li class="nav-item">
          <form class="d-flex" role="search">
        <%= render 'shared/search_novel_form' %>

          </form>
        </li>

        <!-- ダークモード切り替え -->
        <li class="nav-item">
          <div class="form-check form-switch text-nowrap m-0">
            <input class="form-check-input" type="checkbox" id="darkSwitch"
                   <%= 'checked' if cookies[:bs_theme] == 'dark' %>>
            <label class="form-check-label" for="darkSwitch">ダークモード</label>
          </div>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const switchEl = document.getElementById('darkSwitch');
    const currentTheme = localStorage.getItem('bs-theme') || '<%= cookies[:bs_theme] || "light" %>';

    // 初期テーマ設定
    document.documentElement.setAttribute('data-bs-theme', currentTheme);
    switchEl.checked = (currentTheme === 'dark');

    // 切り替えハンドラ
    switchEl.addEventListener('change', function () {
      const theme = this.checked ? 'dark' : 'light';
      document.documentElement.setAttribute('data-bs-theme', theme);
      localStorage.setItem('bs-theme', theme);

      // クッキーにも保存してサーバーサイドで参照できるように
      fetch('/set_theme', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ theme: theme })
      });
    });
  });
</script>
