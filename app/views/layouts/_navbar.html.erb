<nav class="navbar navbar-expand-lg bg-body-tertiary" data-bs-theme="<%= theme = (cookies[:bs_theme] || 'body') %>" id="mainNavbar">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Novel site name</a>
    <button class="navbar-toggler"
     type="button" 
     data-bs-toggle="collapse" 
     data-bs-target="#navMenu">
    <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">

    <!-- ハンバーガーメニュー -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto text-center gap-2 px-2">
        <%# ナビリンクたち %>
        <li class="nav-item">
          <%= link_to new_novel_path, class: "nav-link py-2 px-3" do %>
            <i class="bi bi-journal-plus me-1"></i> 新規投稿
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to "#", class: "nav-link py-2 px-3" do %>
            <i class="bi bi-bookmark-fill me-1"></i> ブックマーク
          <% end %>
        </li>

        <% if current_user %>
          <li class="nav-item">
            <%= link_to user_path(current_user), class: "nav-link py-2 px-3" do %>
              <i class="bi bi-person-circle me-1"></i> マイページ
            <% end %>
          </li>
          <li class="nav-item">
            <%= button_to logout_path,
                          method: :delete,
                          form: { class: "d-inline" },
                          class: "btn btn-sm btn-outline-light mt-1 px-3" do %>
              <i class="bi bi-box-arrow-right me-1"></i> ログアウト
            <% end %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to new_user_path, class: "nav-link py-2 px-3" do %>
              <i class="bi bi-person-plus me-1"></i> 登録
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to login_path, class: "nav-link py-2 px-3" do %>
              <i class="bi bi-box-arrow-in-right me-1"></i> ログイン
            <% end %>
          </li>
        <% end %>
      </ul>
            <form class="d-flex ms-3 align-items-center">
        <div class="form-check form-switch text-nowrap">
          <input
            class="form-check-input"
            type="checkbox"
            id="darkSwitch"
            <%= 'checked' if cookies[:bs_theme] == 'dark' %>
          >
          <label class="form-check-label" for="darkSwitch">ダークモード</label>
        </div>
      </form>
    </div>
  </div>
</nav>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const switchEl = document.getElementById('darkSwitch');
    const currentTheme = localStorage.getItem('bs-theme') || '<%= cookies[:bs_theme] || "light" %>';

    // 初期テーマ設定
    document.documentElement.setAttribute('data-bs-theme', currentTheme);
    switchEl.checked = (currentTheme === 'dark');

    // 切り替えハンドラ
    switchEl.addEventListener('change', function () {
      const theme = this.checked ? 'dark' : 'light';
      document.documentElement.setAttribute('data-bs-theme', theme);
      localStorage.setItem('bs-theme', theme);

      // クッキーにも保存してサーバーサイドで参照できるように
      fetch('/set_theme', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ theme: theme })
      });
    });
  });
</script>