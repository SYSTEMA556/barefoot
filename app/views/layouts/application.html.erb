<!DOCTYPE html>
<html lang="ja" data-bs-theme="<%= cookies[:bs_theme] || 'light' %>">
<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho&family=Noto+Serif+JP:wght@400;700&display=swap">
  <meta charset="UTF-8">
  <title>Novel site name</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- 🌙 Bootstrap CSS（CDN） -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
    crossorigin="anonymous">

  <%= javascript_importmap_tags %>
</head>


 <body class="d-flex flex-column min-vh-100 bg-body">

  <!-- ナビゲーション -->
  <%= render "layouts/navbar" %>
  
  <div class="container-fluid mt-3">
    <% flash.each do |type, msg| %>
      <div class="alert alert-<%= type == :notice ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
  </div>

  <!-- メインコンテンツ -->
  <main class="flex-fill container-fluid py-4">
 <main class="flex-fill container-fluid py-4 bg-body">
    <div class="mx-auto px-3 content-body">
      <%= yield %>
    </div>
  </main>

  <!-- 🌙 Bootstrap JS（Popper 同梱）-->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    crossorigin="anonymous"></script>
</body>
</html>
