<%= render 'shared/error_messages', object: @novel %>

<div class="container-fluid my-4">
  <div class="row">
    <!-- フォームカラム -->
    <div class="col-md-8">
      <%= form_with model: @novel, url: novels_path, local: true, html: { id: 'novel-form' } do |f| %>
      <%= f.hidden_field :preview_mode, value: 'false', id: 'preview-mode-field' %>
        <!-- タイトル -->
        <div class="mb-3">
          <%= f.text_field :title, class: 'form-control', placeholder: 'タイトル' %>
        </div>
        <!-- 著者名 -->
        <div class="mb-3">
          <%= f.text_field :author_name, class: 'form-control', placeholder: '著者名' %>
        </div>
        <!-- 本文 -->
        <div class="mb-4">
          <%= f.text_area :body, class: 'form-control', rows: 12, placeholder: 'ここに本文を書いてね…' %>
        </div>
        <!-- タグ -->
        <div class="mb-3">
          <%= f.label :tag_list, 'タグ（スペース区切り）' %>
          <%= f.text_field :tag_list, class: 'form-control', placeholder: '例：ファンタジー 冒険 恋愛' %>
        </div>

         <!-- パスワード入力（必須） -->
  <div class="mb-3">
    <%= f.label :password, "編集用パスワード", class: "form-label" %>
    <%= f.password_field :password, class: "form-control", required: true, autocomplete: "new-password" %>
    <div class="form-text">
      作品を編集するときに必要になりますので、忘れないようにしてくださいませ。
    </div>
  </div>

  <!-- パスワード確認（必須） -->
  <div class="mb-3">
    <%= f.label :password_confirmation, "パスワード（確認用）", class: "form-label" %>
    <%= f.password_field :password_confirmation, class: "form-control", required: true, autocomplete: "new-password" %>
  </div>
        <!-- フォント選択 -->
        <div class="mb-3">
        <%= f.label :font_choice, 'フォント' %>
<%= f.select :font_choice,
             [
               ['Shippori Mincho（Google）', 'Shippori Mincho'],
               ['Noto Serif JP（Google）',   'Noto Serif JP'],
               ['こぶり明朝',               'こぶり明朝'],
               ['游ゴシック',               '游ゴシック'],
               ['MS明朝',                   'MS明朝'],
               ['ヒラギノ角ゴ',             'ヒラギノ角ゴ']
             ],
             {}, class: 'form-select' %>
        </div>
        <!-- 送信ボタン -->
       <div class="mb-3 d-flex gap-2">
        <%= button_tag 'プレビュー', type: 'submit', class: 'btn btn-secondary',
            onclick: "document.getElementById('preview-mode-field').value = 'true'; this.form.action='#{preview_novels_path}'" %>


        <%= f.submit '投稿する', class: 'btn btn-primary' %>
      </div>
      <% end %>
    </div>

  