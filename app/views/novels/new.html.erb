<%= render 'shared/error_messages', object: @novel %>

<div class="container-fluid my-4">
  <div class="row">
    <!-- フォームカラム -->
    <div class="col-md-8">
      <%= form_with model: @novel, url: novels_path, local: true, html: { id: 'novel-form' } do |f| %>
        <!-- タイトル -->
        <div class="mb-3">
          <%= f.text_field :title, class: 'form-control', placeholder: 'タイトル' %>
        </div>
        <!-- 著者名 -->
        <div class="mb-3">
          <%= f.text_field :author_name, class: 'form-control', placeholder: '著者名' %>
        </div>
        <!-- 本文 -->
        <div class="mb-4">
          <%= f.text_area :body, class: 'form-control', rows: 12, placeholder: 'ここに本文を書いてね…' %>
        </div>
        <!-- タグ -->
        <div class="mb-3">
          <%= f.label :tag_list, 'タグ（スペース区切り）' %>
          <%= f.text_field :tag_list, class: 'form-control', placeholder: '例：ファンタジー 冒険 恋愛' %>
        </div>
        <!-- フォント選択 -->
        <div class="mb-3">
          <%= f.label :font_choice, 'フォント' %>
          <%= f.select :font_choice,
                       ['こぶり明朝','游ゴシック','MS明朝','ヒラギノ角ゴ'],
                       {}, class: 'form-select' %>
        </div>
        <!-- 送信ボタン -->
        <div class="mb-3">
          <%= f.submit '投稿する', class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>

    <!-- プレビューカラム -->
    <div class="col-md-4">
      <h5>プレビュー</h5>
      <div id="preview" class="border rounded p-3"></div>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const form    = document.getElementById('novel-form');
  const preview = document.getElementById('preview');

  if (!form || !preview) {
    console.error('フォームまたはプレビュー要素が見つかりませんでしたわ。IDをチェックして！');
    return;
  }

  function renderPreview() {
    const titleField  = form.querySelector('[name="novel[title]"]');
    const authorField = form.querySelector('[name="novel[author_name]"]');
    const bodyField   = form.querySelector('[name="novel[body]"]');
    const fontField   = form.querySelector('[name="novel[font_choice]"]');

    preview.style.fontFamily = fontField.value || 'inherit';
    preview.innerHTML = `
      <h2>${titleField.value}</h2>
      <p><em>作者：${authorField.value}</em></p>
      <div>${bodyField.value.replace(/\n/g, '<br>')}</div>
    `;
  }

  form.addEventListener('input', renderPreview);
  renderPreview();
});
</script>