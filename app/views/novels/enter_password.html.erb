<!-- app/views/novels/enter_password.html.erb -->

<h2>パスワード入力</h2>
<p>この作品を編集するには、パスワードが必要ですわ。</p>

<%= form_with url: verify_password_novel_path(@novel), local: true do |f| %>
  <div class="form-group">
    <%= f.label :password, "編集用パスワード", class: "form-label" %><br>
    <%= f.password_field :password, class: "form-control", autofocus: true %>
  </div>

  <% if flash.now[:alert] %>
    <p style="color:red;"><%= flash.now[:alert] %></p>
  <% end %>

  <div class="form-group">
    <%= f.submit "確認する", class: "btn btn-success" %>
    <%= link_to "戻る", novel_path(@novel), class: "btn btn-secondary" %>
  </div>
<% end %>
