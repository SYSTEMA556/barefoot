<!-- app/views/novels/_novel_card.html.erb -->
<div class="col">
  <%= link_to novel_path(novel), class: "text-decoration-none" do %>
    <div class="card h-100 shadow-sm border-0 bg-body">
      <div class="card-body d-flex flex-column p-3">
        <!-- タイトル -->
        <h5 class="card-title mb-2 fs-6">
          <i class="bi bi-music-note me-1"></i><%= truncate(novel.title, length: 28) %>
        </h5>

        <!-- 作者 -->
        <div class="card-subtitle mb-2 text-body-secondary small">
         
        </div>

        <!-- ステータス -->
        <% if novel.respond_to?(:status) && novel.draft? %>
          <span class="badge text-bg-secondary mb-2">下書き</span>
        <% end %>

        <!-- 本文抜粋 -->
        <p class="card-text small text-body flex-grow-1 lh-sm">
          <%= truncate(novel.body, length: 100) %>
        </p>

        <!-- メタ情報 -->
        <div class="mt-2 text-wrap text-body-secondary small">
          <%= novel.published? ?
              "投稿日：" + l(novel.created_at, format: :custom_ja) :
              "更新日：" + l(novel.updated_at, format: :short) %>
        </div>
        <div class="text-body-secondary small">
          💬 <%= novel.respond_to?(:comments_count) ? novel.comments_count : (novel.comments.size rescue 0) %>
        </div>
      </div>
    </div>
  <% end %>
</div>
