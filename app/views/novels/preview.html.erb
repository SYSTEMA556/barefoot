<h1>プレビュー：<%= @novel.title %></h1>
<p>作者：<%= @novel.author_name %></p>
<div class="novel-body">
  <%= simple_format(@novel.body) %>
</div>

<%= link_to "編集に戻る",
    new_novel_path(novel: @preview_params),
    class: "btn btn-secondary" %>

<%= link_to "投稿する",
    novels_path(novel: @preview_params),
    method: :post,
    class: "btn btn-primary" %>
