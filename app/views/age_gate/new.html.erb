<div class="gate-card">
    <meta name="color-scheme" content="light dark"><!-- ★ ここに追加 -->

  <h1 class="text-center mb-4">この先は成人向けですわ</h1>
  <%= form_with url: "/gate", method: :post, class: "gate-form" do |f| %>
    <div class="mb-2">
      <%= check_box_tag :adult, "1", false %>
      <%= label_tag :adult, "私は18歳以上です" %>
    </div>

<div class="mb-4">
 <%= check_box_tag :agree_tos, "1", false, id: "agree_tos" %>
<%= label_tag :agree_tos, class: "form-check-label" do %>
  <%= link_to "利用規約・プライバシーポリシー", terms_and_privacy_path, target: "_blank", rel: "noopener" %>に同意します
<% end %>
</div>

    <%= f.submit "入館する", class: "btn btn-primary w-100" %>
  <% end %>
</div>
