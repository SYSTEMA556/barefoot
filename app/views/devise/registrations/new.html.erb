<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
<div class="field mb-3">
  <%= f.label :user_name, 'ユーザー名', class: 'form-label fw-bold text-primary' %>
  <%= f.text_field :user_name, autofocus: true, class: 'form-control' %>
</div>
  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "メールアドレス" %>
  </div>

  <div class="field">
    <%= f.label :password %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "パスワード" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "パスワード" %>
  </div>

  <div class="actions">
    <%= f.submit "新規登録！" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
